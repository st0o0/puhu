<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>puhu</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <!-- Keep the published release clean: no own .pdb and no transitive .pdb/.xml
       from referenced projects (Termina ships XML docs) next to the single-file exe.
       Release-only so local Debug builds keep their symbols. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Puhu.Plugin\Puhu.Plugin.csproj" />
    <ProjectReference Include="..\Puhu.Marketplace\Puhu.Marketplace.csproj" />
    <ProjectReference Include="..\Puhu.Settings\Puhu.Settings.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Akka.Logger.Serilog" />
    <PackageReference Include="Akka.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Servus" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Themes\**\*.theme" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Puhu.Tests" />
    <InternalsVisibleTo Include="Puhu.Settings" />
  </ItemGroup>
</Project>
