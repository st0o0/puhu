<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>Puhu.Plugin</id>
    <version>$version$</version>
    <authors>st0o0</authors>
    <license type="expression">MIT</license>
    <description>Plugin SDK for building Puhu TUI plugins</description>
    <tags>puhu tui plugin sdk</tags>
    <readme>docs\README.md</readme>
    <projectUrl>https://github.com/st0o0/puhu</projectUrl>
    <repository type="git" url="https://github.com/st0o0/puhu" />
    <dependencies>
      <group targetFramework="net10.0">
        <dependency id="Akka.Hosting" version="1.5.68" />
        <dependency id="Microsoft.Extensions.DependencyInjection.Abstractions" version="10.0.8" />
        <dependency id="R3" version="1.3.1" />
      </group>
    </dependencies>
  </metadata>
  <files>
    <file src="bin\$configuration$\net10.0\Puhu.Plugin.dll" target="lib\net10.0" />
    <file src="bin\$configuration$\net10.0\Termina.dll" target="lib\net10.0" />
    <file src="README.md" target="docs\" />
  </files>
</package>
